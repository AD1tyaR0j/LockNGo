# Copy to .env and fill in. Never commit .env. All values below are placeholders.
# Server-only: none of these are ever bundled into the admin web or mobile apps.

NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/smartlocker
# Used only by the API test suite (it drops and recreates this database's schema).
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/smartlocker_test
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
LOG_LEVEL=info
# Number of trusted reverse-proxy hops in front of the API (0 = trust none; see config.ts).
TRUST_PROXY_HOPS=0
SESSION_TTL_HOURS=72

# Secret pepper for locker PIN hashes (>= 32 random chars). Generate: openssl rand -base64 48
ACCESS_PIN_PEPPER=

# Payments. Only the MOCK provider exists in Milestone 1 (no money moves).
PAYMENT_PROVIDER=mock
# HMAC secret the mock gateway signs webhooks with. Generate: openssl rand -hex 32
MOCK_PAYMENT_WEBHOOK_SECRET=
# Enables the mock checkout helper endpoint. Must be false outside local development.
ENABLE_DEV_TOOLS=true

PAYMENT_HOLD_MINUTES=10
QUOTE_TTL_MINUTES=15
DEVICE_OFFLINE_AFTER_SECONDS=90
UNLOCK_COMMAND_TTL_SECONDS=60
DOOR_CLOSE_TIMEOUT_SECONDS=300
PIN_MAX_FAILED_ATTEMPTS=5
SWEEPER_INTERVAL_SECONDS=15

# Optional: password for seeded demo accounts (local only).
SEED_DEMO_PASSWORD=

# ---- Not used yet (future phases). Keep empty until the integration exists. ----
REDIS_URL=
MQTT_BROKER_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
MAPS_API_KEY=
PUSH_NOTIFICATION_CONFIG=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# ---- Admin web (apps/admin-web) — server-side only (Next.js route handlers) ----
ADMIN_API_URL=http://localhost:4000
